<header>
        <div class="logo">
            СДЮШОР №4
            <span data-lang-key="logo_sub">г. Могилев</span>
        </div>
        <div class="header-controls">
            <div class="lang-switch">
                <button class="lang-btn active" onclick="setLang('ru', event)">RU</button>
                <button class="lang-btn" onclick="setLang('by', event)">BY</button>
                <button class="lang-btn" onclick="setLang('en', event)">EN</button>
            </div>
            <button class="btn-accessible" onclick="toggleAccessible()">
                <span>👁</span> <span data-lang-key="btn_accessible">Для слабовидящих</span>
            </button>
        </div>
    </header>
