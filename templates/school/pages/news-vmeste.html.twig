        <main>
            <div class="card page-title-card">
                <h1>Областная антинаркотическая акция «Вместе»</h1>
                <a href="{{ path('my_module.school_page', {page: 'anti-drug'}) }}" style="color: #1976D2; text-decoration: none; font-size: 0.9rem;">← Назад к антинаркотическому уголку</a>
